# OpenMob server settings. Copy this file to .env, fill in what you use, and keep it private:
#
#   cp .env.example .env
#   chmod 600 .env          # the server refuses a .env that other users can read, or that you don't own
#
# `openmob` reads ./.env from the directory you run it in (or the file named by --env-file PATH). The file is
# read as data, never run as a shell script: one NAME=value per line (`export NAME=value` works too), quotes
# as in a shell, `#` starts a comment at the start of a line or after a space (KEY=abc#def keeps abc#def). Only
# the names below are accepted; any other name refuses the whole file. Every command that loads the file prints
# the names it set (never the values). A variable already set in your terminal wins over this file. Leave a value
# blank to leave it unset.
#
# Never commit .env: it is in .gitignore. Never paste its contents into an issue or a chat.

# ---------------------------------------------------------------------------------------------------------------
# Model providers. REQUIRED: at least one. The built-in agent sends the phone's screen content (Accessibility
# text and, when needed, screenshots) to the provider that runs the task. config.yaml picks which model runs
# (the default is Anthropic's Claude); models without a key show as unavailable.
# ---------------------------------------------------------------------------------------------------------------

# Anthropic (Claude). The default config uses it, and provider fallback is Claude-only.
ANTHROPIC_API_KEY=
# Optional: only for an Anthropic key that isn't scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# OpenAI (GPT). Needs: pip install -e '.[openai]'
OPENAI_API_KEY=

# Google (Gemini). Either name works. Needs: pip install -e '.[gemini]'
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Alibaba Model Studio (Qwen). Either key name works. The default endpoint is Singapore; set the one for your
# key's region. Needs: pip install -e '.[openai]'
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=

# xAI (Grok). XAI_BASE_URL defaults to https://api.x.ai/v1. Needs: pip install -e '.[openai]'
XAI_API_KEY=
XAI_BASE_URL=

# Any OpenAI-compatible endpoint, including a local model server. The key only if the endpoint requires one.
# Needs: pip install -e '.[openai]'
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Optional: Jev, a screen classifier from TypeSafe (a third-party service, not part of OpenMob). Without this key
# Jev is off and everything still works through the main model. With it, TypeSafe receives the phone's screen
# text on each step; if a phone's owner also turns on Faster mode (off by default, only on the phone, with its
# screen lock), it also receives small screenshots of screens without readable text and of game screens.
# Never of banking, wallet or password apps. Details: docs/safety.md#faster-mode
# ---------------------------------------------------------------------------------------------------------------

TYPESAFE_API_KEY=
# Set to off to keep Jev off even with a key.
OPENMOB_JEV=

# ---------------------------------------------------------------------------------------------------------------
# Server. All optional.
# ---------------------------------------------------------------------------------------------------------------

# Every public address your dashboard answers at, comma-separated (e.g. https://openmob.example.com). The agent
# refuses to open your own dashboard on a phone; the server never learns its address from a request.
OPENMOB_PUBLIC_URL=
# Where accounts, paired phones and history live. Default: ~/.config/openmob. Back it up; keep it private.
OPENMOB_DATA_DIR=
# The phone app the server offers at /download/openmob.apk. Default: the debug build in android/ of this repo.
OPENMOB_APK=
# Preferences memory (on/off). Default: config.yaml's `memory` (off).
OPENMOB_MEMORY=
# The address on the landing page's "Request an invite" link. Default: none (the link is hidden).
OPENMOB_INVITE_EMAIL=
# The oldest app build (versionCode) that gets tasks; an older phone stays connected but is told to update.
# 0 or blank: no minimum.
OPENMOB_MIN_APP_VERSION=
# Model call timeout in seconds, for every provider. Default: config.yaml's model_timeout_s.
OPENMOB_MODEL_TIMEOUT_S=

# ---------------------------------------------------------------------------------------------------------------
# Release signing: only if you serve your own signed app to other people (docs/release-signing.md).
# ---------------------------------------------------------------------------------------------------------------

# 1: serve only a release build of the app (not debuggable, https only, signed by a key in
# OPENMOB_RELEASE_SIGNERS). The Docker image sets it. Blank: serve whatever OPENMOB_APK is (fine for your phones).
OPENMOB_REQUIRE_RELEASE_APK=
# Your release key's certificate SHA-256 (scripts/om keygen and scripts/check_release_apk.py print it),
# comma-separated for more than one. Required when OPENMOB_REQUIRE_RELEASE_APK=1: with none, nothing is served.
OPENMOB_RELEASE_SIGNERS=
