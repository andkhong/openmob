    <!-- Setup (step 4) -->
    <string name="rd_setup_welcome_body">OpenMob connects this phone to an OpenMob server (by default %1$s), so an agent can tap, type and open apps for you.</string>
    <string name="rd_setup_welcome_risky">You approve anything risky</string>
    <string name="rd_setup_welcome_risky_body">Purchases, sends and installs wait for your screen lock.</string>
    <string name="rd_setup_welcome_see">You see it, and can stop it</string>
    <string name="rd_setup_welcome_see_body">By default, a border and a Stop button show whenever it acts. You can turn them off in Settings.</string>
    <string name="rd_setup_welcome_off">Some apps are always off limits</string>
    <string name="rd_setup_welcome_off_body">Banking, wallet and password apps. It never types passwords or PINs.</string>
    <string name="rd_setup_welcome_note">3 steps · about 2 minutes · needs a screen lock</string>
    <string name="rd_setup_pair_body">On your computer, open the OpenMob dashboard › Connect a phone.</string>
    <string name="rd_setup_pair_qr">Scan its QR code with this phone\'s camera app. The link opens OpenMob, which asks you to confirm the account with your screen lock.</string>
    <string name="rd_setup_pair_qr_title">With the QR code</string>
    <string name="rd_setup_code_body">It\'s under the QR code on your dashboard › Connect a phone: \"Can\'t scan? Show a code to type\".</string>
    <string name="rd_setup_code_label">Pairing code</string>
    <string name="rd_setup_code_hint">K7P-2QX</string>
    <string name="rd_setup_code_expire">Codes expire 5 minutes after they appear.</string>
    <string name="rd_setup_code_case">6 characters. Capitals or not, dash or not: k7p2qx works.</string>
    <string name="rd_setup_code_letters">Codes never use 0 O 1 I L, so there\'s nothing to mix up.</string>
    <string name="rd_setup_code_shape">A pairing code has 6 letters and digits, like K7P-2QX. Check it on your dashboard.</string>
    <string name="rd_setup_code_server">Server: %1$s</string>
    <string name="rd_setup_code_scan">Scan the QR code instead</string>
    <string name="rd_setup_checking">Checking…</string>
    <string name="rd_setup_more_own">Your own server</string>
    <string name="rd_setup_more_own_body">For a self-hosted OpenMob. Get the code from that server\'s dashboard.</string>
    <string name="rd_setup_more_address">Server address</string>
    <string name="rd_setup_more_address_hint">https://home-server.local</string>
    <string name="rd_setup_more_address_help">https:// only. Plain http:// only for this phone or your local network.</string>
    <string name="rd_setup_more_signin">Sign in on this phone</string>
    <string name="rd_setup_more_signin_body">No computer nearby</string>
